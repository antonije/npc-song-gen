# Local ACE-Step 1.5 API (default when you run: uv run acestep-api --port 8001)
ACESTEP_API_BASE=http://localhost:8001

# Only needed if you started the server with --api-key / ACESTEP_API_KEY
ACESTEP_API_KEY=

# Pin ACE-Step API to physical GPU 0 (RTX 3080 Ti). Demucs uses another GPU.
# Note: GTX 1080 Ti (Pascal) cannot run current ACE-Step/PyTorch CUDA wheels
# (cudaErrorNoKernelImageForDevice). Keep ACE-Step on the 3080 Ti.
ACESTEP_CUDA_VISIBLE_DEVICES=0

# Demucs secondary GPU (GTX 1080 Ti). Examples: cuda:1 | cuda:2 | cpu
DEMUCS_DEVICE=cuda:1

# Quality preset: default | sft-1.7b | xl | xl-sft
NPC_SONG_GEN_QUALITY=default

# ACE-Step startup defaults (used by scripts/ensure_acestep.sh)
# Leave PATH2/PATH3 empty unless you want XL models preloaded (uses extra VRAM).
ACESTEP_CONFIG_PATH=acestep-v15-sft
ACESTEP_CONFIG_PATH2=
ACESTEP_CONFIG_PATH3=
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_INIT_LLM=true
# Apple Silicon: scripts/ensure_acestep.sh sets ACESTEP_LM_BACKEND=mlx automatically.
# ACESTEP_LM_BACKEND=mlx
